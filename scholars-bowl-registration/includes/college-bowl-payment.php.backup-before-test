        $to = $payment->email;
        $subject = 'College Bowl Tournament Payment Confirmation';
        
        $event_name = get_option("cbp_event_name", "Upcoming College Bowl Tournament at Southern Union State Community College");
        $event_info_contact = get_option("cbp_event_info_contact", "Brent Catchings bcatchings@suscc.edu");
        $billing_contact = get_option("cbp_billing_contact", "Jonathan Herston jherston@suscc.edu");
        $message = "Dear {$payment->name},\n\n";
        $message .= "We have successfully received your payment for the {$event_name}!\n\n";
        $message .= "Below are the details of your payment for any documentation needs you may have with your college. If you have any questions or issues, feel free to reach out to us.\n\n";
        $message .= "For event information contact {$event_info_contact}\n";
        $message .= "For billing and payment questions contact {$billing_contact}\n\n";
        $message .= "We look forward to seeing you soon!\n\n";
        $message .= "Sincerely,\n";
        $message .= "SUSCC Social Sciences Department\n\n";
        $message .= "----------------------------------------\n";
        $message .= "PAYMENT RECEIPT\n";
        $message .= "----------------------------------------\n\n";
        $message .= "Receipt Date: " . date('F j, Y', strtotime($payment->payment_date)) . "\n";
        $message .= "Name: {$payment->name}\n";
        $message .= "College: {$payment->college_name}\n";
        $message .= "Event: {$event_name}\n";
        $message .= "Number of Teams: {$payment->num_teams}\n";
        $message .= "Payment Method: Credit Card\n";
        $message .= "Amount Paid: $" . number_format($payment->amount, 2) . "\n";
        $message .= "Transaction ID: {$payment->stripe_payment_intent_id}\n\n";
        $message .= "This receipt confirms your payment has been processed successfully.\n";
        
        $headers = array(
            'Content-Type: text/plain; charset=UTF-8',
            'From: SUSCC Social Sciences <jherston@suscc.edu>'
        );
        
        return wp_mail($to, $subject, $message, $headers);
    }
    
