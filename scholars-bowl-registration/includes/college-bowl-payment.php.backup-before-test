<?php
if (!defined('ABSPATH')) exit;

class SBR_College_Bowl_Payment {
    private $table_name;
    
    public function __construct() {
        global $wpdb;
        $this->table_name = $wpdb->prefix . 'college_bowl_payments';
        add_action('init', array($this, 'init'));
    }
    
    public function init() {
        add_shortcode('college_bowl_payment', array($this, 'payment_form_shortcode'));
        add_action('wp_ajax_cbp_process_payment', array($this, 'process_payment'));
        add_action('wp_ajax_nopriv_cbp_process_payment', array($this, 'process_payment'));
        add_action('wp_enqueue_scripts', array($this, 'enqueue_scripts'));
    }
    
    public function enqueue_scripts() {
        if (has_shortcode(get_post()->post_content ?? '', 'college_bowl_payment')) {
            wp_enqueue_script('stripe-js', 'https://js.stripe.com/v3/', array(), null, true);
            wp_enqueue_style('cbp-styles', SBR_PLUGIN_URL . 'assets/college-bowl.css', array(), SBR_VERSION);
        }
    }
    
