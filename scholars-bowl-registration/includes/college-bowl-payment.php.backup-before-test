            echo '<div class="cbp-error">Payment system is not configured. Please contact the administrator.</div>';
            return ob_get_clean();
        }
        
        ?>
        <div id="college-bowl-payment-form">
            <h2><?php echo esc_html(get_option("cbp_event_name", "Upcoming College Bowl Tournament at Southern Union State Community College")); ?> Payment</h2>
            <p>Please complete the form below to pay for your College Bowl team registration.</p>
            
            <form id="cbp-payment-form">
                <?php wp_nonce_field('cbp_payment', 'cbp_nonce'); ?>
                
                <div class="cbp-form-group">
                    <label for="cbp_name">Full Name *</label>
                    <input type="text" id="cbp_name" name="name" required>
                </div>
                
                <div class="cbp-form-group">
                    <label for="cbp_email">Email Address *</label>
                    <input type="email" id="cbp_email" name="email" required>
                </div>
                
                <div class="cbp-form-group">
                    <label for="cbp_college">College Name *</label>
                    <input type="text" id="cbp_college" name="college_name" required>
                </div>
                
                <div class="cbp-form-group">
                    <label for="cbp_teams">Number of Teams *</label>
                    <select id="cbp_teams" name="num_teams" required onchange="cbpCalculateTotal()">
                        <option value="">Select number of teams</option>
                        <option value="1">1 Team - $<?php echo number_format(get_option('cbp_one_team_price', 150), 2); ?></option>
                        <option value="2">2 Teams - $<?php echo number_format(get_option('cbp_two_team_price', 200), 2); ?></option>
                    </select>
                </div>
                
                <div class="cbp-total-display" id="cbp_total_display" style="display: none;">
                    <h3>Total Amount: <span id="cbp_amount">$0.00</span></h3>
                </div>
                
                <div class="cbp-form-group">
                    <label>Credit Card Information</label>
                    <div id="card-element" class="cbp-card-element"></div>
