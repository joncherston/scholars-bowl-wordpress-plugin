        <script>
        var cbpStripe = Stripe('<?php echo esc_js($publishable_key); ?>');
        var cbpElements = cbpStripe.elements();
        var cbpCard = cbpElements.create('card', {
            style: {
                base: {
                    fontSize: '16px',
                    color: '#32325d',
                    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
                    '::placeholder': {
                        color: '#aab7c4'
                    }
                },
                invalid: {
                    color: '#fa755a',
                    iconColor: '#fa755a'
                }
            }
        });
        cbpCard.mount('#card-element');
        
        cbpCard.on('change', function(event) {
            var displayError = document.getElementById('card-errors');
            if (event.error) {
                displayError.textContent = event.error.message;
            } else {
                displayError.textContent = '';
            }
        });
        
        var cbpPricing = {
            1: <?php echo floatval(get_option("cbp_one_team_price", 150)); ?>,
            2: <?php echo floatval(get_option("cbp_two_team_price", 200)); ?>
        };
        
        function cbpCalculateTotal() {
            var teams = parseInt(document.getElementById("cbp_teams").value);
            var amount = cbpPricing[teams] || 0;
            }
            
            if (amount > 0) {
                document.getElementById('cbp_amount').textContent = '$' + amount.toFixed(2);
                document.getElementById('cbp_total_display').style.display = 'block';
            } else {
                document.getElementById('cbp_total_display').style.display = 'none';
            }
        }
        
        document.getElementById('cbp-payment-form').addEventListener('submit', function(event) {
            event.preventDefault();
            
            var teams = document.getElementById('cbp_teams').value;
            if (!teams) {
                alert('Please select number of teams');
                return;
            }
            
            var submitBtn = document.getElementById('cbp_submit_btn');
            var processingDiv = document.getElementById('cbp_processing');
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Processing...';
            processingDiv.style.display = 'block';
            
            cbpStripe.createPaymentMethod({
                type: 'card',
                card: cbpCard,
                billing_details: {
                    name: document.getElementById('cbp_name').value,
                    email: document.getElementById('cbp_email').value
                }
            }).then(function(result) {
                if (result.error) {
                    document.getElementById('card-errors').textContent = result.error.message;
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Process Payment';
                    processingDiv.style.display = 'none';
                } else {
                    cbpProcessPayment(result.paymentMethod.id);
                }
            });
        });
        
        function cbpProcessPayment(paymentMethodId) {
            var formData = new FormData();
            formData.append('action', 'cbp_process_payment');
            formData.append('nonce', document.querySelector('[name="cbp_nonce"]').value);
            formData.append('payment_method_id', paymentMethodId);
            formData.append('name', document.getElementById('cbp_name').value);
            formData.append('email', document.getElementById('cbp_email').value);
            formData.append('college_name', document.getElementById('cbp_college').value);
            formData.append('num_teams', document.getElementById('cbp_teams').value);
            
            fetch('<?php echo admin_url('admin-ajax.php'); ?>', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(function(data) {
                if (data.success) {
                    if (data.data.requires_action) {
                        cbpStripe.confirmCardPayment(data.data.client_secret).then(function(result) {
                            if (result.error) {
                                alert('Payment failed: ' + result.error.message);
                                location.reload();
                            } else {
                                window.location.href = data.data.redirect_url;
                            }
                        });
                    } else {
                        window.location.href = data.data.redirect_url;
                    }
                } else {
                    alert('Error: ' + data.data);
                    location.reload();
                }
            })
            .catch(function(error) {
                alert('An error occurred. Please try again.');
                location.reload();
            });
        }
        </script>
        <?php
        
        return ob_get_clean();
    }
    
    public function process_payment() {
        check_ajax_referer('cbp_payment', 'nonce');
        
        global $wpdb;
        
        // Get form data
        $name = sanitize_text_field($_POST['name']);
        $email = sanitize_email($_POST['email']);
        $college_name = sanitize_text_field($_POST['college_name']);
        $num_teams = intval($_POST['num_teams']);
        $payment_method_id = sanitize_text_field($_POST['payment_method_id']);
        
        // Calculate amount
        $amount = ($num_teams === 1) ? floatval(get_option('cbp_one_team_price', 150)) : floatval(get_option('cbp_two_team_price', 200));
        
        // Validate
        if (empty($name) || empty($email) || !in_array($num_teams, [1, 2])) {
            wp_send_json_error('Invalid form data');
        }
        
        // Get Stripe secret key
        $stripe_mode = get_option('sbr_stripe_mode', 'test');
        $secret_key = ($stripe_mode === 'live') 
            ? get_option('sbr_stripe_live_secret_key', '') 
            : get_option('sbr_stripe_test_secret_key', '');
            
        if (empty($secret_key)) {
            wp_send_json_error('Payment system not configured');
        }
        
        // Process with Stripe
        require_once SBR_PLUGIN_PATH . 'lib/stripe-php/init.php';
        
        try {
            \Stripe\Stripe::setApiKey($secret_key);
            
            $payment_intent = \Stripe\PaymentIntent::create([
                'amount' => intval($amount * 100),
                'currency' => 'usd',
                'payment_method' => $payment_method_id,
                'confirm' => true,
                'description' => "College Bowl - {$college_name} - {$num_teams} team(s)",
                'receipt_email' => $email,
                'metadata' => [
                    'name' => $name,
                    'college' => $college_name,
                    'teams' => $num_teams
                ]
            ]);
            
            if ($payment_intent->status === 'succeeded') {
                // Save to database
                $payment_id = $wpdb->insert(
                    $this->table_name,
                    array(
                        'name' => $name,
                        'email' => $email,
                        'college_name' => $college_name,
                        'num_teams' => $num_teams,
                        'amount' => $amount,
                        'stripe_payment_intent_id' => $payment_intent->id,
                        'payment_date' => current_time('mysql'),
                        'ip_address' => $this->get_client_ip(),
                        'transaction_details' => json_encode([
                            'payment_method' => $payment_method_id,
                            'status' => $payment_intent->status
                        ])
                    ),
                    array('%s', '%s', '%s', '%d', '%f', '%s', '%s', '%s', '%s')
                );
                
                if ($payment_id) {
                    // Send confirmation email
                    $this->send_confirmation_email($wpdb->insert_id);
                    
                    wp_send_json_success(array(
                        'redirect_url' => add_query_arg([
                            'cbp_success' => '1',
                            'payment_id' => $wpdb->insert_id
                        ], get_permalink())
                    ));
                } else {
                    wp_send_json_error('Payment processed but database error occurred. Please contact support.');
                }
            } elseif ($payment_intent->status === 'requires_action') {
                wp_send_json_success(array(
                    'requires_action' => true,
                    'client_secret' => $payment_intent->client_secret
                ));
            } else {
                wp_send_json_error('Payment failed. Please try again.');
            }
            
        } catch (\Stripe\Exception\CardException $e) {
            wp_send_json_error($e->getMessage());
        } catch (Exception $e) {
            wp_send_json_error('Payment processing error: ' . $e->getMessage());
        }
    }
    
    private function send_confirmation_email($payment_id) {
